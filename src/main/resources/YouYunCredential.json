{
  "data": [
    {
      "type": "combobox",
      "name": "itsmType",
      "label": "$[{i18n_itsm_handler_type}]",
      "defaultValue": "",
      "textField": "desc",
      "valueField": "key",
      "optionList": [
        {"desc":"$[{i18n_itsm_oa_handler}]","key": "OA"},
        {"desc":"$[{i18n_itsm_esb_handler}]","key": "ESB"}
      ],
      "required": true,
      "notifyMsg": "$[{i18n_please_select_itsm_handler_type}]",
      "deleted": "return currentProduct.systemType === 'PROCESS' ? false : true"
    },
    {
      "type": "combobox",
      "name": "integrationType",
      "label": "$[{i18n_itsm_integration_type}]",
      "defaultValue": "OA",
      "textField": "text",
      "valueField": "key",
      "descField": "desc",
      "optionList": [
        {"text":"$[{i18n_itsm_create_external_order_when_submit}]","key":"CreateExternalOrderWhenSubmit","desc":"$[{i18n_itsm_create_external_order_when_submit_desc}]"},
        {"text":"$[{i18n_itsm_external_order_ready_before_submit}]","key":"ExternalOrderReadyBeforeSubmit","desc": "$[{i18n_itsm_external_order_ready_before_submit_desc}]"}
      ],
      "required": true,
      "notifyMsg": "$[{i18n_please_select_integration_type}]",
      "deleted": "return currentProduct.itsmType === 'OA' ? false : true"
    },
    {
      "type": "text",
      "name": "modelId",
      "label": "$[{i18n_itsm_model_code}]",
      "defaultValue": "",
      "required": true,
      "notifyMsg": "$[{i18n_please_input_itsm_id_or_code}]",
      "description": "$[{i18n_youyun_modelid_description}]",
      "deleted": "return currentProduct.integrationType === 'CreateExternalOrderWhenSubmit' && currentProduct.itsmType === 'OA' ? false : true"
    },
    {
      "type": "text",
      "name": "itsmApiKey",
      "defaultValue": "",
      "label": "$[{i18n_youyun_api_key}]",
      "required": true,
      "notifyMsg": "$[{i18n_please_input_youyun_api_key}]",
      "description": "$[{i18n_youyun_api_key_description}]"
    },
    {
      "type": "password",
      "name": "itsmTenantId",
      "defaultValue": "",
      "label": "$[{i18n_youyun_secret_accesskey}]",
      "required": true,
      "notifyMsg": "$[{i18n_please_input_itsm_tenant_id}]",
      "description": "$[{i18n_youyun_secret_access_key_description}]"
    }
  ]
}