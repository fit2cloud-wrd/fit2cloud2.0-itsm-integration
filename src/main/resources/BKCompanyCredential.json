{
  "data": [
    {
      "type": "combobox",
      "name": "itsmType",
      "label": "$[{i18n_itsm_handler_type}]",
      "defaultValue": "OA",
      "textField": "desc",
      "valueField": "key",
      "optionList": [
        {"desc":"$[{i18n_itsm_oa_handler}]","key": "OA"}
      ],
      "required": true,
      "notifyMsg": "$[{i18n_please_select_itsm_handler_type}]",
      "deleted": "return currentProduct.systemType === 'PROCESS' ? false : true"
    },
    {
      "type": "combobox",
      "name": "integrationType",
      "label": "$[{i18n_itsm_integration_type}]",
      "defaultValue": "CreateExternalOrderWhenSubmit",
      "textField": "text",
      "valueField": "key",
      "descField": "desc",
      "optionList": [
        {"text":"$[{i18n_itsm_create_external_order_when_submit}]","key":"CreateExternalOrderWhenSubmit","desc":"$[{i18n_itsm_create_external_order_when_submit_desc}]"},
        {"text":"$[{i18n_itsm_external_order_ready_before_submit}]","key":"ExternalOrderReadyBeforeSubmit","desc": "$[{i18n_itsm_external_order_ready_before_submit_desc}]"}
      ],
      "required": true,
      "notifyMsg": "$[{i18n_please_select_integration_type}]",
      "deleted": "return currentProduct.itsmType === 'OA' ? false : true"
    },
    {
      "type": "text",
      "name": "username",
      "defaultValue": "",
      "label": "$[{i18n_lanjingcompany_zhiyun_username}]",
      "required": true,
      "notifyMsg": "$[{i18n_lanjingcompany_zhiyun_access_username_msg}]",
      "description": "$[{i18n_lanjingcompany_zhiyun_access_username_description}]"
    },
    {
      "type": "text",
      "name": "appCode",
      "defaultValue": "",
      "label": "$[{i18n_lanjingcompany_zhiyun_app_code}]",
      "required": true,
      "notifyMsg": "$[{i18n_lanjingcompany_zhiyun_app_code_description}]",
      "description": "$[{i18n_lanjingcompany_zhiyun_app_code_description}]"
    },
    {
      "type": "password",
      "name": "appSecret",
      "defaultValue": "",
      "label": "$[{i18n_lanjingcompany_zhiyun_app_secret}]",
      "required": true,
      "notifyMsg": "$[{i18n_lanjingcompany_zhiyun_app_secret_description}]",
      "description": "$[{i18n_lanjingcompany_zhiyun_app_secret_description}]"
    }
  ]
}