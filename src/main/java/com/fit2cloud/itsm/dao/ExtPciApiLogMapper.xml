  <select id="getApiLogList" resultMap="BaseResultMap">
    select pal.*, paa.name as apiAccountName, pae.api_type, pae.endpoint,paa.provider_factory_id
    from pci_api_log pal
    INNER JOIN pci_api_endpoint pae on pae.id=pal.api_id
    INNER JOIN pci_api_account paa on pae.api_account=paa.id
    <where>
      <if test="record.systemType != null">
        AND paa.system_type = #{record.systemType,jdbcType=VARCHAR}
      </if>
      <if test="record.apiType != null">
        AND pae.api_type = #{record.apiType,jdbcType=VARCHAR}
      </if>
      <if test="record.apiAccount != null">
        AND pae.api_account = #{record.apiAccount,jdbcType=VARCHAR}
      </if>
      <if test="record.workspace != null">
        AND pal.workspace = #{record.workspace,jdbcType=VARCHAR}
      </if>
      <if test="record.resourceName != null">
        AND pal.resource_name like #{record.resourceName}
      </if>
      <if test="record.code != null">
        AND pal.code = #{record.code,jdbcType=INTEGER}
      </if>
      <if test="record.endpoint != null">
        AND pae.endpoint like #{record.endpoint}
      </if>
    </where>
    <if test="record.sort != null">
      order by ${record.sort}
    </if>
    <if test="record.sort == null">
      order by pal.execute_time desc
    </if>
  </select>
  <select id="countInPushLogs" resultType="java.lang.Integer">
    select count(1)
    from pci_api_log pal
    INNER JOIN pci_api_endpoint pae on pae.id=pal.api_id
    INNER JOIN pci_api_account paa on pae.api_account=paa.id
    <where>
      pal.code='2'
      <if test="params.systemType !=null and params.systemType !=''">
        and paa.system_type=#{params.systemType}
      </if>
    </where>
  </select>

  <select id="getSyncDetailLogs" resultMap="SyncDetailLogResultMapWithBLOBs">
    select *
    from pci_external_system_sync_detail_log
    <where>
      <if test="record.pciApiLogId != null">
        AND pci_api_log_id = #{record.pciApiLogId,jdbcType=VARCHAR}
      </if>
      <if test="record.name != null">
        AND name like #{record.name,jdbcType=VARCHAR}
      </if>
      <if test="record.type != null">
        AND type = #{record.type,jdbcType=BIT}
      </if>
    </where>
    <if test="record.sort != null">
      order by ${record.sort}
    </if>
    <if test="record.sort == null">
      order by create_time desc
    </if>
  </select>

  <select id="getLastSyncApiLog" resultType="String">
    select id from pci_api_log WHERE resource_id='cmdb' and resource_type = #{type} ORDER BY execute_time desc limit 1
